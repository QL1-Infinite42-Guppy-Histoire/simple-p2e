# 簡素版P2E server — environment example. Copy to .env / your service
# manager's environment. NEVER commit a real .env. NEVER put a real
# distribution key anywhere in Phase 1.

PORT=8788
HOST=127.0.0.1
DB_PATH=./data/simple-p2e.db

# Required for /admin/* (status only). Generate a long random value.
ADMIN_SECRET=

# Phase 2 only. Leave EMPTY in Phase 1 — payout stays disabled.
DISTRIBUTION_PRIVATE_KEY=

# Optional overrides (all values are 仮値・未決定 — see src/config.js)
# P2E_MAX_ATTEMPTS_PER_DAY=5
# P2E_DAILY_EARN_CAP=10000
# P2E_HOLD_MS=60000
# QL1_RPC_URL=https://evm-rpc-ql1.mschihuahua.org
