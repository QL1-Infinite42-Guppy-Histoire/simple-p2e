# Dependencies
node_modules/
app/node_modules/

# Expo / Android build outputs
app/android/
app/ios/
app/.expo/
*.apk
*.aab

# Server runtime data — the points ledger must never be committed
server/data/
server/backups/
*.db
*.db-journal
*.db-walnut
*.sqlite
*.sqlite3

# Secrets / environment — real values live only on the server box and in
# the operator's private store. .env.example (no values) is committed.
.env
.env.*
!.env.example
server/.env
*SECRET*.txt
*PRIVATE_KEY*

# Misc
*.log
.DS_Store
